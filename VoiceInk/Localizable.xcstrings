    "This can happen due to an issue with the audio recording or insufficient system resources. Please try again, or restart the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann durch ein Problem mit der Audioaufnahme oder durch unzureichende Systemressourcen auftreten. Bitte versuche es erneut oder starte die App neu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能是由录音问题或系统资源不足导致的。请重试，或重新启动 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso pode acontecer devido a um problema na gravação de áudio ou a recursos insuficientes do sistema. Tente novamente ou reinicie o aplicativo."
          }
        }
      }
    },
    "This deactivates VoiceInk on this Mac and frees a device on your license.": {
      "comment": "A message displayed in a confirmation dialog when the user deactivates their license.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird VoiceInk auf diesem Mac deaktiviert und ein Geräteplatz in deiner Lizenz freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deactivates VoiceInk on this Mac and frees a device on your license."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将在此 Mac 上停用 VoiceInk，并释放许可证中的一个设备名额。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desativa o VoiceInk neste Mac e libera um dispositivo na sua licença."
          }
        }
      }
    },
    "This filler word already exists.": {
