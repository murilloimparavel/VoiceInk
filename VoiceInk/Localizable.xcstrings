      }
    },
    "VoiceInk Refine is not downloaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine wurde nicht heruntergeladen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
