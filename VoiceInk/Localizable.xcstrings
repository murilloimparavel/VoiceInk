          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk"
          }
        }
      }
    },
    "VoiceInk app is not available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk-App ist nicht verfügbar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk App 不可用"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo VoiceInk não está disponível"
          }
        }
      }
    },
    "VoiceInk automatically understands what you are working with and selects your preferred setup. You can always configure this by editing or creating new modes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk erkennt automatisch, woran du arbeitest, und wählt deine bevorzugte Konfiguration aus. Du kannst dies jederzeit anpassen, indem du Modi bearbeitest oder neue erstellst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 会自动识别你正在处理的内容，并选用你偏好的设置。你随时可以通过编辑或创建新模式来进行配置。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk compreende automaticamente com o que você está trabalhando e seleciona sua configuração preferida. Você sempre pode ajustar isso editando ou criando novos modos."
          }
        }
      }
    },
    "VoiceInk can select the right mode from the app you are using and the rules you configure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk kann anhand der verwendeten App und der konfigurierten Regeln den passenden Modus auswählen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 可以根据你正在使用的 App 和你配置的规则选择合适的模式。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk pode selecionar o modo correto com base no aplicativo que você está usando e nas regras configuradas."
          }
        }
      }
    },
    "VoiceInk could not switch to another microphone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk konnte nicht zu einem anderen Mikrofon wechseln."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 无法切换到其他麦克风。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk não conseguiu alternar para outro microfone."
          }
        }
      }
    },
    "VoiceInk couldn't access its storage location. Your transcriptions will not be saved between sessions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk konnte nicht auf den Speicherort zugreifen. Deine Transkriptionen werden nicht zwischen Sitzungen gespeichert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 无法访问其存储位置。你的转写记录将无法跨会话存储。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk não conseguiu acessar seu local de armazenamento. Suas transcrições não serão salvas entre as sessões."
          }
        }
      }
    },
    "VoiceInk couldn't access the macOS Keychain. Quit and reopen VoiceInk. If the problem continues, restart your Mac.": {
      "comment": "Error message displayed when the macOS Keychain is unavailable.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk konnte nicht auf den macOS-Schlüsselbund zugreifen. Beende VoiceInk und öffne die App erneut. Falls das Problem weiterhin besteht, starte deinen Mac neu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 无法访问 macOS 钥匙串。请退出并重新打开 VoiceInk。如果问题仍然存在，请重新启动 Mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk não conseguiu acessar o Chaveiro do macOS. Encerre e reabra o VoiceInk. Se o problema continuar, reinicie o Mac."
          }
        }
      }
    },
    "VoiceInk couldn't remove the saved license. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk konnte die gespeicherte Lizenz nicht entfernen. Bitte versuche es erneut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 无法移除已保存的许可证。请重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk não conseguiu remover a licença salva. Tente novamente."
          }
        }
      }
    },
    "VoiceInk couldn't save the license. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk konnte die Lizenz nicht speichern. Bitte versuche es erneut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 无法保存许可证。请重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk não conseguiu salvar a licença. Tente novamente."
          }
        }
      }
    },
    "VoiceInk couldn't start the trial because the macOS Keychain is unavailable. Quit and reopen VoiceInk. If the problem continues, restart your Mac.": {
      "comment": "Error message displayed when the macOS Keychain is unavailable while starting a trial.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk konnte den Testzeitraum nicht starten, da der macOS-Schlüsselbund nicht verfügbar ist. Beende VoiceInk und öffne die App erneut. Falls das Problem weiterhin besteht, starte deinen Mac neu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 无法开始试用，因为 macOS 钥匙串不可用。请退出并重新打开 VoiceInk。如果问题仍然存在，请重新启动 Mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk não conseguiu iniciar o teste porque o Chaveiro do macOS está indisponível. Encerre e reabra o VoiceInk. Se o problema continuar, reinicie o Mac."
          }
        }
      }
    },
