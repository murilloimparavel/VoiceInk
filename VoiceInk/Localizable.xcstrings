        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk Refine não foi baixado."
          }
        }
      }
    },
    "VoiceInk Refine only supports transcript cleanup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine unterstützt nur die Transkriptbereinigung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine 仅支持转录文本清理。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk Refine suporta apenas a limpeza de transcrições."
          }
        }
      }
    },
    "VoiceInk Refine received an invalid request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine hat eine ungültige Anfrage erhalten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine 收到了无效请求。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk Refine recebeu uma requisição inválida."
          }
        }
      }
    },
    "VoiceInk Refine requires an Apple silicon Mac with at least 16 GB of memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine erfordert einen Mac mit Apple-Chip und mindestens 16 GB Arbeitsspeicher."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine 需要配备 Apple 芯片且内存至少为 16 GB 的 Mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk Refine requer um Mac com Apple silicon e pelo menos 16 GB de memória."
          }
        }
      }
    },
    "VoiceInk Refine returned an invalid response.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine hat eine ungültige Antwort zurückgegeben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk Refine 返回了无效响应。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk Refine retornou uma resposta inválida."
          }
        }
      }
    },
    "VoiceInk temporarily uses the clipboard to paste transcription. When enabled, it restores your previous clipboard content after the selected delay. When disabled, the pasted transcription stays on your clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk nutzt die Zwischenablage vorübergehend zum Einfügen der Transkription. Wenn aktiviert, wird der frühere Inhalt der Zwischenablage nach der gewählten Verzögerung wiederhergestellt. Wenn deaktiviert, bleibt die Transkription in der Zwischenablage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 会临时使用剪贴板来粘贴转写内容。打开后，它会在所选延迟后恢复你之前的剪贴板内容。关闭后，粘贴的转写内容会保留在剪贴板中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk usa temporariamente a área de transferência para colar a transcrição. Quando ativado, ele restaura o conteúdo anterior da área de transferência após o atraso selecionado. Quando desativado, a transcrição colada permanece na área de transferência."
          }
        }
      }
    },
    "VoiceInk uses Accessibility to type transcriptions directly into any app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk verwendet Bedienungshilfen, um Transkriptionen direkt in jede App einzugeben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 使用辅助功能将转写内容直接输入到任何 App 中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk usa a Acessibilidade para digitar transcrições diretamente em qualquer aplicativo."
          }
        }
      }
    },
    "VoiceInk uses LLMs to enhance transcripts and perform AI actions. Set up an API key before continuing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
