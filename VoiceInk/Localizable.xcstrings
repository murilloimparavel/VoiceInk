                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Diese Aktion kann nicht rückgängig gemacht werden. Sollen wirklich %lld Elemente gelöscht werden?"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
