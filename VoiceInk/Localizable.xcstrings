          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用模拟的 Cmd+V 按键事件。当自定键盘布局无法正确粘贴时，AppleScript 会有所帮助。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão usa eventos simulados de tecla Cmd+V. O AppleScript pode ajudar quando layouts de teclado personalizados não colarem corretamente."
          }
        }
      }
