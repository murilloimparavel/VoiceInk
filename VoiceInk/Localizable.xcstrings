    "'%@' is not available for the %@ mode": {
      "comment": "A title for a notification that informs the user that a transcription model is unavailable. The first argument is the name of the model. The second argument is the name of the mode.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist für den Modus „%2$@“ nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "'%1$@' is not available for the %2$@ mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”在“%2$@”模式中不可用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' não está disponível para o modo %@"
          }
        }
      }
    },
    "'%@' is the default mode. Set another mode as default before deleting it.": {
      "comment": "A warning alert that appears when the user tries to delete a mode that is set as the default mode. The argument is the name of the mode.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist der Standardmodus. Lege vor dem Löschen einen anderen Modus als Standard fest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是默认模式。请先将其他模式设为默认模式，然后再删除它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' é o modo padrão. Defina outro modo como padrão antes de apagá-lo."
          }
        }
      }
    },
