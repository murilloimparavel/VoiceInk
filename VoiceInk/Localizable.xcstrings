    "VoiceInk is private by default. No data leaves your device unless you opt in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk ist standardmäßig privat. Keine Daten verlassen dein Gerät, sofern du dem nicht zustimmst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInk 默认保护隐私。除非你主动选择，否则任何数据都不会离开你的设备。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceInk é privado por padrão. Nenhum dado sai do seu dispositivo, a menos que você opte por isso."
          }
        }
      }
    },
    "VoiceInk Modes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
