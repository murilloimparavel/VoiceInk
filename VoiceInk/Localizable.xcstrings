        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的用户权限在本地运行。最终转写文本通过 stdin 传入，并以 VOICEINK_TRANSCRIPT 形式提供。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
